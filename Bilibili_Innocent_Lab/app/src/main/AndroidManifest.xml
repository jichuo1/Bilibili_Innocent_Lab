<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        漫游设置入口点击中转：本机 B 站进程对任何其他包都不可见（系统级包可见性
        隔离），无法直接 startActivity 打开 me.iacn.biliroaming；改为 B 站点击 →
        RoamingCompatProvider（本模块 App 代开漫游设置）。本声明使模块 App 对
        me.iacn.biliroaming 可见（Android 11+ 包可见性）。
    -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="tv.danmaku.bili" />
        <package android:name="me.iacn.biliroaming" />
        <!-- 条款待同步页只在管理器入口确实可解析时显示快捷按钮。 -->
        <package android:name="org.lsposed.manager" />
        <package android:name="org.lsposed.lspatch" />
        <package android:name="top.nkbe.npatch" />
        <package android:name="org.matrix.vector.manager" />
        <package android:name="com.android.shell" />
        <!-- NPatch Local/Manager 模式的 Remote API Provider 可见性。 -->
        <provider android:authorities="top.nkbe.npatch.remote" />
        <!-- 只读查询哔哩哔哩当前的作用域，用于发现作用域被移除后仍显示已激活。 -->
        <provider android:authorities="top.nkbe.npatch.manager.provider.config" />
    </queries>

    <!--
        仅模块 App 可以向运行在 B 站进程中的动态 Receiver 写入漫游开关。
        Receiver 所在进程不需要持有该权限；系统校验的是广播发送者。
    -->
    <permission
        android:name="${applicationId}.permission.SET_ROAMING_COMPAT"
        android:protectionLevel="signature" />

    <!-- 仅模块 App 可通知 B 站进程刷新模块注入界面的语言快照。 -->
    <permission
        android:name="${applicationId}.permission.SET_UI_LOCALE"
        android:protectionLevel="signature" />

    <!-- 仅模块 App 可以向 B 站主进程查询“我的”页扫描结果。 -->
    <permission
        android:name="${applicationId}.permission.QUERY_MINE_COMPONENT_SNAPSHOT"
        android:protectionLevel="signature" />

    <!-- 仅模块 App 可以向 B 站主进程查询不含业务数据的运行时诊断回执。 -->
    <permission
        android:name="${applicationId}.permission.QUERY_HOST_RUNTIME_DIAGNOSTICS"
        android:protectionLevel="signature" />

    <!-- 仅模块 App 可以向 B 站主进程询问“模块是否正在运行”（B12 存活探测）。 -->
    <permission
        android:name="${applicationId}.permission.PROBE_HOST_RUNTIME"
        android:protectionLevel="signature" />

    <uses-permission android:name="${applicationId}.permission.SET_ROAMING_COMPAT" />
    <uses-permission android:name="${applicationId}.permission.SET_UI_LOCALE" />
    <permission android:name="${applicationId}.permission.APPLY_LIVE_CONFIG" android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.permission.APPLY_LIVE_CONFIG" />
    <uses-permission android:name="${applicationId}.permission.QUERY_MINE_COMPONENT_SNAPSHOT" />
    <uses-permission android:name="${applicationId}.permission.QUERY_HOST_RUNTIME_DIAGNOSTICS" />
    <uses-permission android:name="${applicationId}.permission.PROBE_HOST_RUNTIME" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 仅供自定义背景的相册兜底使用：系统照片选择器不可用时才会申请 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:name=".application.DefaultApplication"
        android:allowBackup="false"
        android:description="@string/xposed_desc"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppDefault"
        tools:targetApi="33">

        <!-- 官方要求的系统级权限保护；普通应用不能向此 Provider 注入 Binder。 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
            Android 12 及以下由 AppCompat 保存应用语言；Android 13+ 交由系统
            应用语言设置管理。服务本身不启动，也不暴露组件。
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
            跨进程只读降级通道：目标进程（B 站）通过 content:// 读取漫游开关、
            自由复制配置及模块注入 UI 的语言标签，解决部分 LSPosed 构建下
            XSharedPreferences 跨应用读取被 SELinux 拦截的问题。
        -->
        <service
            android:name=".runtime.compat.CompatibilityReceiptService"
            android:enabled="true"
            android:exported="true" />

        <!-- 仅用户启动的短任务；绑定事务验证宿主 UID，不接受外部 Intent 目标或命令。 -->
        <service
            android:name=".agent.AgentSessionService"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User initiated Bilibili assistant task with visible progress and stop control" />
        </service>

        <service android:name=".agent.AgentAccessibilityService"
            android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/agent_accessibility_service" />
        </service>
        <receiver android:name=".agent.AgentNotificationReceiver" android:exported="false" />

        <provider
            android:name=".provider.HostBackgroundProvider"
            android:authorities="${applicationId}.hostbackground"
            android:exported="true"
            android:grantUriPermissions="true" />

        <provider
            android:name=".provider.HostAdmissionProvider"
            android:authorities="${applicationId}.admission"
            android:exported="true" />

        <provider
            android:name=".provider.RoamingCompatProvider"
            android:authorities="${applicationId}.roaming"
            android:exported="true" />

        <!--
            漫游设置入口点击中转：B 站进程对本模块不可见（无法用 Provider），
            点击「哔哩漫游设置」时 B 站发送显式广播到本接收器，模块返回固定目标
            凭证，由仍可见的 B 站发送并接受系统启动策略检查（见 RoamingOpenReceiver）。
        -->
        <receiver
            android:name=".receiver.RoamingOpenReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.Bilibili_Innocent_Lab.xposedmodule.QUERY_HOOK_ADMISSION" />
            </intent-filter>
        </receiver>

        <!-- 显式宿主通知：校验 PendingIntent 创建者 UID，API 34+ 再校验共享发送者 UID。 -->
        <receiver
            android:name=".receiver.TelemetryHostReadyReceiver"
            android:exported="true" />

        <!--
            覆盖安装不会自动打开模块设置页；由系统替换广播启动模块进程，
            让 DefaultApplication 刷新版本化授权镜像，再由接收器在 B 站下次启动前
            重建、同步用户仍开启的当前版本严格配置快照。
        -->
        <receiver
            android:name=".receiver.TermsMirrorRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".ui.activity.MainActivity"
            android:exported="true"
            android:screenOrientation="behind">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!--
            自由复制界面目前只供模块内部复用；实际长按交互使用 B 站进程内 Dialog，
            因此不再暴露任意文本展示入口。
        -->
        <activity
            android:name=".ui.activity.FreeCopyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.AppDefault" />

        <activity
            android:name=".ui.activity.SettingsBackupActivity"
            android:exported="false"
            android:screenOrientation="behind"
            android:theme="@style/Theme.SettingsBackupTransition" />

        <activity
            android:name=".ui.activity.DiagnosticsActivity"
            android:exported="false"
            android:screenOrientation="behind"
            android:theme="@style/Theme.DiagnosticsTransition" />

        <activity-alias
            android:name=".Home"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="behind"
            android:targetActivity=".ui.activity.MainActivity">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
