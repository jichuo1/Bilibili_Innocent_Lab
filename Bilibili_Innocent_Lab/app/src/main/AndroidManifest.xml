<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        漫游设置入口点击中转：本机 B 站进程对任何其他包都不可见（系统级包可见性
        隔离），无法直接 startActivity 打开 me.iacn.biliroaming；改为 B 站点击 →
        RoamingCompatProvider（本模块 App 代开漫游设置）。本声明使模块 App 对
        me.iacn.biliroaming 可见（Android 11+ 包可见性）。
    -->
    <queries>
        <package android:name="tv.danmaku.bili" />
        <package android:name="me.iacn.biliroaming" />
        <!-- NPatch Local/Manager 模式的 Remote API Provider 可见性。 -->
        <provider android:authorities="top.nkbe.npatch.remote" />
    </queries>

    <!--
        仅模块 App 可以向运行在 B 站进程中的动态 Receiver 写入漫游开关。
        Receiver 所在进程不需要持有该权限；系统校验的是广播发送者。
    -->
    <permission
        android:name="${applicationId}.permission.SET_ROAMING_COMPAT"
        android:protectionLevel="signature" />

    <!-- 仅模块 App 可通知 B 站进程刷新模块注入界面的语言快照。 -->
    <permission
        android:name="${applicationId}.permission.SET_UI_LOCALE"
        android:protectionLevel="signature" />

    <uses-permission android:name="${applicationId}.permission.SET_ROAMING_COMPAT" />
    <uses-permission android:name="${applicationId}.permission.SET_UI_LOCALE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".application.DefaultApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppDefault"
        tools:targetApi="33">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/module_scope" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_desc" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />

        <!--
            Android 12 及以下由 AppCompat 保存应用语言；Android 13+ 交由系统
            应用语言设置管理。服务本身不启动，也不暴露组件。
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
            跨进程只读降级通道：目标进程（B 站）通过 content:// 读取漫游开关、
            自由复制配置及模块注入 UI 的语言标签，解决部分 LSPosed 构建下
            XSharedPreferences 跨应用读取被 SELinux 拦截的问题。
        -->
        <provider
            android:name=".provider.RoamingCompatProvider"
            android:authorities="${applicationId}.roaming"
            android:exported="true" />

        <!--
            漫游设置入口点击中转：B 站进程对本模块不可见（无法用 Provider），
            点击「哔哩漫游设置」时 B 站发送显式广播到本接收器，由模块 App
            代开 me.iacn.biliroaming 的设置界面（见 RoamingOpenReceiver）。
        -->
        <receiver
            android:name=".receiver.RoamingOpenReceiver"
            android:exported="true" />

        <activity
            android:name=".ui.activity.MainActivity"
            android:exported="true"
            android:screenOrientation="behind">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!--
            自由复制界面目前只供模块内部复用；实际长按交互使用 B 站进程内 Dialog，
            因此不再暴露任意文本展示入口。
        -->
        <activity
            android:name=".ui.activity.FreeCopyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.AppDefault" />

        <activity
            android:name=".ui.activity.SettingsBackupActivity"
            android:exported="false"
            android:screenOrientation="behind"
            android:theme="@style/Theme.SettingsBackupTransition" />

        <activity-alias
            android:name=".Home"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="behind"
            android:targetActivity=".ui.activity.MainActivity">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
